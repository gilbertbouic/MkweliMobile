# Dependencies
node_modules/
**/node_modules/

# React Native / Metro
.metro-health-check*
*.jsbundle
.expo/
dist/
web-build/

# Android build outputs & caches
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
*.hprof
.cxx/

# Release APKs are not kept in git: they are built by the "Build signed release
# APK" workflow and published on https://aml.mkweli.tech/
*.apk
*.aab

# iOS
ios/Pods/
ios/build/
*.xcworkspace
!default.xcworkspace
*.xcuserstate
DerivedData/

# Native / tooling
# Signing keys must never be committed (only the public RN debug key is allowed)
*.keystore
*.jks
*.p12
*.lineage
!android/app/debug.keystore
android/keystores/

# Env / secrets (keep committed if project already relies on them)
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
*.swp
*~
.gradle/

# Logs & coverage
*.log
npm-debug.*
coverage/
.jest/

# Temporary
*.tmp
*.temp
/tmp/
